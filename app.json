{
  "expo": {
    "name": "FitPulse",
    "slug": "fitpulse-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitpulse.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0f"
      },
      "package": "com.fitpulse.app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "FitPulse needs access to your photos to analyze ingredients.",
          "cameraPermission": "FitPulse needs camera access to take ingredient photos."
        }
      ],
      "expo-camera",
      "expo-font",
      "expo-audio",
      "expo-asset"
    ],
    "newArchEnabled": true
  }
}
